@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam ArrowColor #334155
skinparam defaultBorderColor #334155
skinparam classAttributeIconSize 0
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor #EFF6FF
skinparam classBackgroundColor #F8FAFC
skinparam sequenceMessageAlign center
hide footbox
left to right direction
actor "Persona usuaria" as Persona
actor "Supabase Auth" as Auth <<servicio externo>>
rectangle "Sistema web — Acceso y cuentas" {
  usecase "Registrarse" as Registro
  usecase "Iniciar sesión" as Login
  usecase "Recuperar contraseña" as Recuperar
  usecase "Cerrar sesión" as Logout
}
Persona -- Registro
Persona -- Login
Persona -- Recuperar
Persona -- Logout
Auth -- Registro
Auth -- Login
Auth -- Recuperar
Auth -- Logout
@enduml
