# Configuración del servidor Flask
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

# Conexión con Supabase
# Obtén estos valores en tu dashboard de Supabase (Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-o-service-role-key

# Clave secreta para firma de JSON Web Tokens (JWT)
JWT_SECRET_KEY=clave_secreta_jwt_para_firmar_tokens_2026
