# Configuración del servidor Flask
FLASK_APP=app.py
FLASK_DEBUG=0
PORT=5000

# Conexión con Supabase
# Obtén estos valores en tu dashboard de Supabase (Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave secreta sb_secret_... (también admite service_role heredada)
SUPABASE_KEY=tu-clave-secreta-solo-backend

# Origen del frontend: debe coincidir con Site URL y Redirect URLs en Supabase Auth.
# No se necesita una clave JWT propia ni claves de Supabase en el frontend.
FRONTEND_URL=http://127.0.0.1:5173

# Notificaciones opcionales. Habilitar después de configurar bot y chat.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Asistente opcional: OpenAI Responses, modelo con function calling.
ASSISTANT_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=
