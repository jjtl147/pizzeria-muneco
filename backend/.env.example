# Configuración del servidor Flask
FLASK_APP=app.py
FLASK_DEBUG=0
PORT=5000

# Conexión con Supabase
# Obtén estos valores en tu dashboard de Supabase (Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave secreta sb_secret_... (también admite service_role heredada)
SUPABASE_KEY=tu-clave-secreta-solo-backend

# Clave secreta para firma de JSON Web Tokens (JWT)
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Pegar una clave aleatoria de al menos 32 caracteres. No compartirla.
JWT_SECRET_KEY=

# Notificaciones opcionales. Habilitar después de configurar bot y chat.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Asistente opcional: OpenAI Responses, modelo con function calling.
ASSISTANT_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=
